# Local development only. Never point a fixture build at the live service.
EXPO_PUBLIC_QINGMU_API_BASE_URL=http://127.0.0.1:8787
EXPO_PUBLIC_QINGMU_FIXTURE=true
EXPO_PUBLIC_QINGMU_DEV_TOKEN=local-development-only
QINGMU_SERVER_PORT=8787
QINGMU_DB_PATH=./data/development.sqlite
QINGMU_INSTANCE_ID=local-development
QINGMU_FIXTURE_ROSTER=two-member-week
QINGMU_DEV_TOKEN=local-development-only
QINGMU_REMINDER_WORKER_AUTOSTART=false

# Request your own YouVersion App Key. Empty means the reader is unavailable.
EXPO_PUBLIC_YOUVERSION_APP_KEY=
EXPO_PUBLIC_QINGMU_YV_TEXT_PROBE=false

# Optional real Google sign-in: use your own Google/Firebase project.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_SERVICES_FILE=
# QINGMU_GOOGLE_SERVER_CLIENT_ID=
# QINGMU_SESSION_SECRET=

# Optional remote meeting delivery: use your own Firebase sender credentials.
# QINGMU_FCM_PROJECT_ID=
# QINGMU_FCM_CREDENTIAL_FILE=
# Enable QINGMU_REMINDER_WORKER_AUTOSTART only after configuring the sender.

# A release build reads these from the environment, not from this file, and refuses to start
# without them. They are listed here because the failure they prevent is a silent one: with the
# base url unset the bundle falls back to 127.0.0.1, which on a phone is the phone.
#   EXPO_PUBLIC_QINGMU_API_BASE_URL   the public host the phone reaches, never localhost
#   QINGMU_RELEASE_SIGNING_PROPERTIES path to the keystore properties; the key must be the one
#                                     already on the device, or the build cannot install over it
#   QINGMU_ANDROID_TOOL_ROOT          only if the toolchain is not where the script now defaults
