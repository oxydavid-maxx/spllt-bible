{
  "expo": {
    "name": "青牧青年",
    "slug": "qingmu-youth",
    "version": "0.5.5",
    "orientation": "portrait",
    "scheme": "org.qingmu.youth",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withQingmuReleaseSigning",
      "./plugins/withQingmuNetworkSecurity",
      "./plugins/withQingmuReleaseSlimming",
      "./plugins/withQingmuPermissionFloor",
      [
        "expo-camera",
        {
          "cameraPermission": "允許青牧掃描好友 QR",
          "recordAudioAndroid": false
        }
      ],
      "expo-local-authentication",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-notifications",
      "react-native-nitro-google-signin",
      "./plugins/withQingmuProguardRules"
    ],
    "android": {
      "package": "org.qingmu.youth",
      "versionCode": 26,
      "adaptiveIcon": {
        "backgroundColor": "#1E5C4B"
      }
    },
    "ios": {
      "bundleIdentifier": "org.qingmu.youth"
    },
    "extra": {
      "contentMode": "C_PENDING_ACCESS",
      "fixture": true
    }
  }
}
