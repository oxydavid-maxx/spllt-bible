{
  "expo": {
    "name": "竹科聖經",
    "slug": "qingmu-youth",
    "version": "0.5.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "org.qingmu.youth",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withQingmuReleaseSigning",
      "./plugins/withQingmuNetworkSecurity",
      "./plugins/withQingmuReleaseSlimming",
      "./plugins/withQingmuPermissionFloor",
      [
        "expo-camera",
        {
          "cameraPermission": "允許竹科聖經掃描好友 QR 碼",
          "recordAudioAndroid": false
        }
      ],
      "expo-local-authentication",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-notifications",
      "react-native-nitro-google-signin",
      "./plugins/withQingmuProguardRules"
    ],
    "android": {
      "package": "org.qingmu.youth",
      "versionCode": 33,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "org.qingmu.youth"
    },
    "extra": {
      "contentMode": "C_PENDING_ACCESS",
      "fixture": true
    }
  }
}
