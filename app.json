{
  "expo": {
    "name": "竹科聖經",
    "slug": "qingmu-youth",
    "version": "0.5.19",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "org.qingmu.youth",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withQingmuReleaseSigning",
      "./plugins/withQingmuNetworkSecurity",
      "./plugins/withQingmuReleaseSlimming",
      "./plugins/withQingmuPermissionFloor",
      "./plugins/withGoogleSignInPods",
      [
        "expo-camera",
        {
          "cameraPermission": "允許竹科聖經掃描好友 QR 碼",
          "microphonePermission": "竹科聖經不會錄音；這是系統元件要求的說明",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": "竹科聖經不會錄音；這是系統元件要求的說明",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "允許竹科聖經用 Face ID 解鎖管理功能"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "允許竹科聖經用 Face ID 解鎖管理功能"
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "react-native-nitro-google-signin",
      "./plugins/withQingmuProguardRules"
    ],
    "android": {
      "package": "org.qingmu.youth",
      "versionCode": 40,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "org.qingmu.youth",
      "buildNumber": "40",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "contentMode": "C_PENDING_ACCESS",
      "fixture": true
    }
  }
}
